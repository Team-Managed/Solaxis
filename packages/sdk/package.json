{
  "name": "@solaxis/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Public Developer SDK for Solaxis Serverless Web3 Micro-Instances",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "echo 'SDK unit tests will be implemented in Unit 05'",
    "lint": "echo 'Linting @solaxis/sdk...'"
  },
  "dependencies": {
    "@solaxis/shared": "workspace:*",
    "@solana/web3.js": "^1.98.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "typescript": "^5.7.3"
  }
}
